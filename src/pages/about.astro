---
import DetailLayout from '../layouts/DetailLayout.astro';
import {site, timeline, stack, age} from '../data/site';
---

<DetailLayout name="about" label="About" title="About" description={`${site.name} is a builder from Eindhoven and co-founder of Insync.`}>
  <div class="about-grid">
    <div class="story">
      <h1 class="sheet-title">I build things for the web.</h1>
      <p class="lede">I'm Patrick, a builder from Eindhoven. I turn ideas into working web products, from the first sketch to the thing people use every day.</p>
      <p class="prose">I like working with new tech, building something up and seeing how it helps people in their work or personal life. Lately that means building with and for AI agents.</p>
      <p class="prose">I'm co-founder and builder at <strong>Insync</strong>. We believe more and more people will get things done through their own AI assistant, so we make sure our platforms are ready for that: easy to use for people, and just as easy for the agents working on their behalf. Next to that, I still take on independent projects.</p>
    </div>

    <div class="facts-column">
      <section>
        <h2 class="h3">Timeline</h2>
        <ol class="timeline">
          {timeline.map(item => (
            <li>
              <span class="when">{item.when}</span>
              <span class="what">{item.what}</span>
              <span class:list={['where', {now: item.now}]}>{item.where}</span>
            </li>
          ))}
        </ol>
      </section>

      <dl class="facts">
        <dt>based</dt><dd>{site.location}</dd>
        <dt>age</dt><dd>{age()}</dd>
        <dt>stack</dt><dd>{stack.join(', ')}</dd>
      </dl>
    </div>
  </div>
</DetailLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
  }

  .story, .facts-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: clamp(19px, 1.8vw, 26px);
    line-height: 1.3;
    letter-spacing: -.01em;
  }

  .prose {
    margin: 0;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .prose strong {
    color: var(--ink);
    font-weight: 500;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li, .facts {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 2px 16px;
  }

  .timeline li {
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .timeline li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .when, .facts dt {
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .what {
    font-weight: 500;
  }

  .where {
    grid-column: 2;
    font-size: 14px;
    color: var(--ink-2);
  }

  .where.now {
    color: var(--accent);
  }

  .facts {
    gap: 8px 16px;
    margin: 0;
    font-size: 14.5px;
  }

  .facts dd {
    margin: 0;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline li, .facts {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
