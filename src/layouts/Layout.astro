---
import '../styles/global.css'
import {ClientRouter} from 'astro:transitions'
import {site} from '../data/site'

interface Props {
  title?: string;
  description?: string;
  heroImage?: string;
}

const {
  title = `${site.name} - ${site.role}`,
  description = `I'm ${site.name}, a builder from Eindhoven. ${site.intro}`,
  heroImage = "https://patrickhuizinga.nl/logo.svg"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI agents"/>
  <meta property="og:title" content={title}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:site_name" content={site.name}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={heroImage}/>
  <meta name="generator" content={Astro.generator}/>
  <script is:inline src="https://cloud.umami.is/script.js" data-website-id="36625c1c-54fb-4d72-aec9-31d94def45d7" defer></script>
  <title>{title}</title>
  <ClientRouter/>
</head>
<body>
<slot/>

<script>
  // The entrance animation only plays on a fresh load, not when coming back from a detail page
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.dataset.navigated = 'true';
  });

  // Remember which detail page was opened from the home grid, so closing it can go back in history
  // (restoring the scroll position on mobile) instead of starting a new visit to /
  document.addEventListener('click', (event) => {
    const tile = (event.target as Element).closest<HTMLAnchorElement>('a[data-tile]');
    if (!tile) return;
    try {
      sessionStorage.setItem('opened-from-home', new URL(tile.href).pathname);
    } catch {}
  });
</script>
</body>
</html>
